      "power-distribution",
      "ground-spd",
      "edge-data-center",
      "5gc-cloud"
    ],
    "requiredConnections": [
      "AAU/RU -> DU",
      "DU -> CU",
      "CU -> Edge Data Center",
      "Edge Data Center -> 5GC",
      "AC Input -> Rectifier",
      "Cabinet -> Ground/SPD"
    ]
  },
