{
  "sourceProject": "hoainho/img2threejs-inspired workflow",
  "sourceImage": "assets/5g-tower-frameless-3d.png",
  "modelName": "Space-Air-Sea-Ground Communication Digital Twin",
  "method": {
    "intent": "Use multiple reference images as a design brief, then rebuild the 5G tower, receiver/transmitter equipment, maritime communication ship, and LEO satellite as structured Three.js geometry instead of treating the images as flat textures.",
    "steps": [
      "Read the images and isolate visible engineering objects across ground, maritime, and orbital communication domains.",
      "Convert objects into named components with approximate scale, role, and connection semantics.",
      "Create the model with procedural Three.js primitives and reusable factories.",
      "Expose layers for technical review: fronthaul, backhaul, power, ground, monitoring, radio endpoints, maritime relay, and satellite links.",
      "Run a quality gate that checks required components, connections, and UI references."
    ]
  },
