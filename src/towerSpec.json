  "modelName": "5G Communication Tower Digital Twin",
  "method": {
    "intent": "Use a reference image as a design brief, then rebuild the subject as structured Three.js geometry instead of treating the image as a flat texture.",
    "steps": [
      "Read the image and isolate visible engineering objects.",
      "Convert objects into named components with approximate scale, role, and connection semantics.",
      "Create the model with procedural Three.js primitives and reusable factories.",
      "Expose layers for technical review: fronthaul, backhaul, power, ground, and monitoring.",
      "Run a quality gate that checks required components, connections, and UI references."
    ]
  },
  "qualityGate": {
